generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  TIKTOK_SHOP
  SHOPEE
  FACEBOOK_MESSENGER
  WEBSITE
  OFFLINE_STORE
  WHOLESALE
  OTHER
}

enum InventoryTransactionType {
  RECEIPT
  SALE
  RESERVATION
  RESERVATION_RELEASE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
  QUARANTINE
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum AfterSaleType {
  CANCELLATION
  RETURN
  EXCHANGE
  REFUND
}

enum ChannelSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ChannelConnectionStatus {
  INCOMPLETE
  READY
  ERROR
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  MISMATCH
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  users     User[]
  roles     Role[]
  products  Product[]
  channels  SalesChannelAccount[]
  customers Customer[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id])
  warehouses     Warehouse[]
  @@unique([organizationId, code])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  displayName    String
  passwordHash   String
  active         Boolean  @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  roleAssignments UserRoleAssignment[]
  @@unique([organizationId, email])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name        String
  permissions Json
  organization Organization @relation(fields: [organizationId], references: [id])
  assignments UserRoleAssignment[]
  @@unique([organizationId, code])
}

model UserRoleAssignment {
  id        String @id @default(cuid())
  userId    String
  roleId    String
  scopeType String
  scopeId   String?
  user      User   @relation(fields: [userId], references: [id])
  role      Role   @relation(fields: [roleId], references: [id])
  @@index([userId, scopeType, scopeId])
  @@unique([userId, roleId, scopeType, scopeId])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  variants       ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique
  barcode   String?  @unique
  name      String
  costPrice Decimal  @db.Decimal(18, 2)
  salePrice Decimal  @db.Decimal(18, 2)
  product   Product  @relation(fields: [productId], references: [id])
  balances  InventoryBalance[]
  mappings  ChannelSkuMapping[]
  orderItems SalesOrderItem[]
  purchaseItems PurchaseOrderItem[]
}

model Warehouse {
  id       String @id @default(cuid())
  branchId String
  code     String
  name     String
  branch   Branch @relation(fields: [branchId], references: [id])
  balances InventoryBalance[]
  transactions InventoryTransaction[]
  orders   SalesOrder[]
  purchaseOrders PurchaseOrder[]
  @@unique([branchId, code])
}

model Supplier {
  id             String @id @default(cuid())
  organizationId String
  code           String
  name           String
  phone          String?
  email          String?
  active         Boolean @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]
  @@unique([organizationId, code])
}

model PurchaseOrder {
  id             String @id @default(cuid())
  organizationId String
  supplierId     String
  warehouseId    String
  orderNumber    String @unique
  status         PurchaseOrderStatus @default(DRAFT)
  expectedAt     DateTime?
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  items          PurchaseOrderItem[]
  @@index([organizationId, status, createdAt])
}

model PurchaseOrderItem {
  id                String @id @default(cuid())
  purchaseOrderId   String
  variantId         String
  orderedQuantity   Int
  receivedQuantity  Int @default(0)
  unitCost          Decimal @db.Decimal(18, 2)
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([purchaseOrderId, variantId])
}

model InventoryBalance {
  id             String @id @default(cuid())
  warehouseId    String
  variantId      String
  onHand         Int    @default(0)
  reserved       Int    @default(0)
  quarantined    Int    @default(0)
  safetyStock    Int    @default(0)
  reorderPoint   Int    @default(0)
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([warehouseId, variantId])
}

model InventoryTransaction {
  id          String @id @default(cuid())
  warehouseId String
  variantId   String
  type        InventoryTransactionType
  quantity    Int
  referenceType String?
  referenceId String?
  reason      String?
  performedById String?
  createdAt   DateTime @default(now())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  @@index([variantId, createdAt])
}

model SalesChannelAccount {
  id             String @id @default(cuid())
  organizationId String
  type           ChannelType
  code           String
  name           String
  externalShopId String?
  active         Boolean @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  skuMappings    ChannelSkuMapping[]
  orders         SalesOrder[]
  conversations  Conversation[]
  syncRuns       ChannelSyncRun[]
  settlements    OrderSettlement[]
  connection     ChannelConnection?
  @@unique([organizationId, code])
}

model ChannelConnection {
  id                      String @id @default(cuid())
  channelAccountId        String @unique
  environment             String @default("PRODUCTION")
  clientId                String?
  accountIdentifier       String?
  apiBaseUrl              String?
  clientSecretEncrypted   String?
  accessTokenEncrypted    String?
  refreshTokenEncrypted   String?
  webhookSecretEncrypted  String?
  status                  ChannelConnectionStatus @default(INCOMPLETE)
  orderSyncEnabled        Boolean @default(true)
  inventorySyncEnabled    Boolean @default(true)
  chatSyncEnabled         Boolean @default(false)
  lastCheckedAt           DateTime?
  lastError               String?
  updatedById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  channelAccount          SalesChannelAccount @relation(fields: [channelAccountId], references: [id])
  @@index([status, updatedAt])
}

model ChannelSyncRun {
  id               String @id @default(cuid())
  channelAccountId String
  status           ChannelSyncStatus @default(RUNNING)
  direction        String @default("PUSH_INVENTORY")
  mappedSkuCount   Int @default(0)
  processedCount   Int @default(0)
  failedCount      Int @default(0)
  snapshot         Json?
  errorMessage     String?
  triggeredById    String?
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  channelAccount   SalesChannelAccount @relation(fields: [channelAccountId], references: [id])
  @@index([channelAccountId, startedAt])
}

model ChannelSkuMapping {
  id               String @id @default(cuid())
  channelAccountId String
  variantId        String
  externalProductId String
  externalSkuId    String
  externalSku      String?
  channelAccount   SalesChannelAccount @relation(fields: [channelAccountId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([channelAccountId, externalSkuId])
}

model Customer {
  id             String @id @default(cuid())
  organizationId String
  displayName    String
  phone          String?
  email          String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  identities     CustomerIdentity[]
  orders         SalesOrder[]
}

model CustomerIdentity {
  id               String @id @default(cuid())
  customerId       String
  channelAccountId String
  externalBuyerId  String
  displayName      String?
  customer         Customer @relation(fields: [customerId], references: [id])
  conversations    Conversation[]
  @@unique([channelAccountId, externalBuyerId])
}

model SalesOrder {
  id               String @id @default(cuid())
  orderNumber      String @unique
  channelAccountId String
  warehouseId      String?
  customerId       String?
  externalOrderId  String?
  status           OrderStatus
  subtotal         Decimal @db.Decimal(18, 2)
  discount         Decimal @default(0) @db.Decimal(18, 2)
  total            Decimal @db.Decimal(18, 2)
  recipientName    String?
  recipientPhone   String?
  recipientAddress String?
  recipientNote    String?
  responsibleUserId String?
  responsibilityAssignedAt DateTime?
  orderedAt        DateTime
  createdAt        DateTime @default(now())
  channelAccount   SalesChannelAccount @relation(fields: [channelAccountId], references: [id])
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  customer         Customer? @relation(fields: [customerId], references: [id])
  items            SalesOrderItem[]
  afterSales       AfterSaleRequest[]
  fulfillmentEvents OrderFulfillmentEvent[]
  settlement     OrderSettlement?
  @@unique([channelAccountId, externalOrderId])
}

model OrderSettlement {
  id                   String @id @default(cuid())
  orderId              String @unique
  channelAccountId     String
  externalSettlementId String?
  grossAmount          Decimal @db.Decimal(18, 2)
  platformFee          Decimal @default(0) @db.Decimal(18, 2)
  shippingFee          Decimal @default(0) @db.Decimal(18, 2)
  refundAmount         Decimal @default(0) @db.Decimal(18, 2)
  otherFee             Decimal @default(0) @db.Decimal(18, 2)
  expectedNetAmount    Decimal @db.Decimal(18, 2)
  paidAmount           Decimal @db.Decimal(18, 2)
  differenceAmount     Decimal @db.Decimal(18, 2)
  status               ReconciliationStatus
  settledAt            DateTime?
  syncedById           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  order                SalesOrder @relation(fields: [orderId], references: [id])
  channelAccount       SalesChannelAccount @relation(fields: [channelAccountId], references: [id])
  @@index([channelAccountId, status, settledAt])
  @@unique([channelAccountId, externalSettlementId])
}

model OrderFulfillmentEvent {
  id            String @id @default(cuid())
  orderId       String
  action        String
  fromStatus    OrderStatus
  toStatus      OrderStatus
  performedById String
  responsibleUserId String?
  carrierName   String?
  trackingCode  String?
  note          String?
  createdAt     DateTime @default(now())
  order         SalesOrder @relation(fields: [orderId], references: [id])
  @@index([orderId, createdAt])
  @@index([performedById, createdAt])
}

model SalesOrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  unitPrice Decimal @db.Decimal(18, 2)
  order     SalesOrder @relation(fields: [orderId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model AfterSaleRequest {
  id               String @id @default(cuid())
  orderId          String
  type             AfterSaleType
  reasonCode       String
  responsibleParty String
  quantity         Int @default(1)
  status           String
  createdAt        DateTime @default(now())
  order            SalesOrder @relation(fields: [orderId], references: [id])
}

model Conversation {
  id                 String @id @default(cuid())
  channelAccountId   String
  customerIdentityId String
  externalId         String
  status             String @default("OPEN")
  assignedUserId     String?
  lastMessageAt      DateTime?
  closedOrderId      String?
  closedByUserId     String?
  closedAt           DateTime?
  channelAccount     SalesChannelAccount @relation(fields: [channelAccountId], references: [id])
  customerIdentity   CustomerIdentity @relation(fields: [customerIdentityId], references: [id])
  messages           Message[]
  @@unique([channelAccountId, externalId])
  @@index([closedByUserId, closedAt])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  externalId     String?
  direction      String
  type           String @default("TEXT")
  content        String
  senderRole     String
  sentAt         DateTime
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  @@unique([conversationId, externalId])
}
