{
  "name": "enterprise-management-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @erp/api prisma:generate",
    "db:migrate": "pnpm --filter @erp/api prisma:migrate"
  }
}
